=== Appendix A: r11_review.py (probes P1-P5 and breaks K1-K5)
"""R11 review: probes on the pristine adapter, then breaks run against the llm tests.

Run with cwd = a byte-exact copy of HEAD's novacore/ and tools/ (git archive,
core.autocrlf=false). Probes import the pristine package; each break edits one
source file, runs the two llm test modules, and restores the bytes.
"""
import os, subprocess, sys, tempfile, textwrap, time, uuid
from pathlib import Path

sys.path.insert(0, "novacore/src")
from novacore.config import ModelConfig
from novacore.llm import LocalCommandBackend, ModelUnavailable

WORK = Path(tempfile.mkdtemp(prefix="r11-review-"))


def runner(name, code):
    path = WORK / name
    path.write_text(textwrap.dedent(code), encoding="utf-8")
    return path


def backend(script, *, stdin=True, max_chars=10_000, timeout=20, extra=()):
    command = (sys.executable, str(script), *extra)
    return LocalCommandBackend(ModelConfig(command, timeout, max_chars, stdin), WORK / "state")


def outcome(fn):
    try:
        return "Ok " + repr(fn())[:120]
    except ModelUnavailable as error:
        return "ModelUnavailable " + repr(str(error)[:160])


print(f"=== probes on the pristine adapter ({sys.version.split()[0]}, os.name={os.name})\n")

# P1. A runner that logs to stderr the way llama.cpp does while loading a model.
# The adapter keeps at most ~4 KB of stderr for its error message; the probe asks
# whether it also stops the runner from writing more.
chatty = runner("chatty.py", """
    import sys
    sys.stdin.buffer.read()
    kib = int(sys.argv[1])
    for i in range(kib):
        sys.stderr.write(f"llama_model_loader: - kv {i:4d}: " + "x" * 990 + "\n")
    sys.stderr.flush()
    print("reply")
""")
for kib in (2, 3, 8, 64):
    for attempt in (1, 2, 3):
        result = outcome(lambda: backend(chatty, extra=(str(kib),)).complete("hello"))
        print(f"P1 stderr {kib:2d} KiB, attempt {attempt}: {result}")
print()

# P2. A runner (file mode) whose helper process still holds the prompt file open
# when the runner exits. Windows refuses to delete an open file.
holder = runner("holder.py", """
    import subprocess, sys, time
    subprocess.Popen(
        [sys.executable, "-c", "import sys, time; f = open(sys.argv[1], 'rb'); time.sleep(6)", sys.argv[1]],
        stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        creationflags=getattr(subprocess, "DETACHED_PROCESS", 0),
    )
    time.sleep(1.5)
    print("reply")
""")
token = f"CANARY_{uuid.uuid4().hex}"
result = outcome(lambda: backend(holder, stdin=False, extra=("{prompt_file}",)).complete(f"secret {token}"))
left = sorted((WORK / "state" / "prompts").glob("prompt-*.txt"))
print(f"P2 helper holds the prompt file: {result}")
print(f"   prompt files left after complete() returned: {len(left)}")
for path in left:
    print(f"   {path.name}: token inside: {token.encode() in path.read_bytes()}")
time.sleep(7)
for path in left:
    path.unlink()
print(f"   (removed by the reviewer after the helper exited: {[p.exists() for p in left]})\n")

# P3. Multi-byte UTF-8 split across the 1024-byte read boundary.
utf8 = runner("utf8.py", """
    import sys
    sys.stdin.buffer.read()
    sys.stdout.buffer.write(("\u00e9" * 3001 + "\u20ac" * 3001 + "\U0001F600" * 1001).encode("utf-8"))
""")
want = "\u00e9" * 3001 + "\u20ac" * 3001 + "\U0001F600" * 1001
got = backend(utf8).complete("hello")
print(f"P3 UTF-8 (2-, 3- and 4-byte chars, 7,003 chars): equal to what the runner wrote: {got == want}")

# P4. The exact truncation form.
flood = runner("flood.py", """
    import sys
    sys.stdin.buffer.read()
    sys.stdout.buffer.write(b"A" * 5000)
""")
got = backend(flood, max_chars=1000).complete("hello")
print(f"P4 5,000 chars, max_output_chars 1,000: reply == 'A'*1000 + '\n[response truncated]': "
      f"{got == 'A' * 1000 + chr(10) + '[response truncated]'}")

# P5. The whole prompt reaches the runner on stdin (1 MiB, more than any pipe buffer).
count = runner("count.py", """
    import sys
    print(len(sys.stdin.buffer.read()))
""")
got = backend(count).complete("p" * (1 << 20))
print(f"P5 1 MiB prompt on stdin, runner counted: {got} bytes (want 1048576)\n")

# Breaks: edit one file, run the two llm test modules, restore.
SRC = Path("novacore/src/novacore")
ENV = dict(os.environ, PYTHONPATH="novacore/src")
TESTS = [sys.executable, "-m", "unittest", "discover", "-s", "novacore/tests", "-p", "test_*llm*.py"]
HOME_LEAK = Path.home() / ".nova-r11-review-leak.txt"
TEMP_LEAK = Path(tempfile.gettempdir()) / "nova-r11-review-leak.txt"
BREAKS = [
    ("K1 item 2 reverted: prompt file O_TRUNC 0o644, prompts dir without 0o700", "llm.py", [
        ("os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600", "os.O_CREAT | os.O_TRUNC | os.O_WRONLY, 0o644"),
        ("prompt_dir.mkdir(parents=True, exist_ok=True, mode=0o700)", "prompt_dir.mkdir(parents=True, exist_ok=True)"),
    ]),
    ("K2 environment not scrubbed (runner inherits every variable)", "llm.py", [
