=== 3. Findings
The done-when is met: the test passes, a planted socket in the code paths the
work order names makes it fail (the author's log has 5; S1-S3 here), and
docs/logs/r14-d2-zero-sockets.log holds both runs. S3 shows a bare
getaddrinfo (no socket object) is seen too.

G1 (not blocking; a gap in the work order, which the lead wrote). The test
never runs the code a real session runs between the owner and the model:
  - S4: a socket in LocalCommandBackend.complete (novacore/src/novacore/llm.py
    line 50) passes test_no_sockets and the full suite (54 tests, OK).
  - S5: a socket in cli._runtime (novacore/src/novacore/cli.py line 36), where
    every real session starts, passes test_no_sockets and the full suite.
  FakeModelRunner replaces LocalCommandBackend, and cli.main is never called.
  Both are novacore's own Python, inside the process the hook watches. The
  runner program is out of scope; the Python that starts it is not.
  Fix: add a second test that runs cli.main(["--config", ..., "--message",
  ...]) under the flag, with [model] command set to a small Python script
  (sys.executable plus a committed fake runner) that prints a reply. Show S4
  and S5 failing in a scratch copy.

Note on the board report. "WHAT I AM UNSURE OF: nothing" is the third such
report from antigravity in a row (R10 follow-up, D5 review, R14). G1 was
findable by planting one socket outside the five paths the author chose.

=== 4. Counts and paths
Full suite: 54 tests, OK (skipped=1), in the baseline, matching the board
report ("54 tests total ... 1 skipped"). The author's log has 5 planted
faults, each "[exit: 1 -> CAUGHT (failed as expected)]" (lines 69, 113, 163,
207, 251). Paths cited, each checked with `test -e`:
novacore/tests/test_no_sockets.py, novacore/src/novacore/llm.py,
novacore/src/novacore/cli.py, docs/logs/r14-d2-zero-sockets.log.

=== 5. Could not do / unsure of
WHAT I COULD NOT DO:
  - Run on POSIX. The audit events are the same in CPython on every OS, but I
    did not see it.
WHAT I AM UNSURE OF:
  - Whether a library the session imports opens a socket at import time,
    before the flag is set. The hook records only while the flag is set, so
    such a socket would not be seen. I found none in novacore's imports
    (stdlib only), but I did not trace every stdlib import.

=== Appendix A: rr3.py
"""Review of R10 follow-up (9af30ce) and R14 (ba85896), by claude.

Run with cwd = a byte-exact copy of HEAD novacore/ and tools/ (git archive,
core.autocrlf=false). Each break edits one source file, runs a test set, and
restores the bytes. A break that the narrow set does not catch is re-run
against the full novacore suite before it is called NOT CAUGHT.
"""
import os, subprocess, sys, tempfile
from pathlib import Path

SRC = Path("novacore/src/novacore")
ENV = dict(os.environ, PYTHONPATH="novacore/src")
UT = [sys.executable, "-m", "unittest", "discover", "-s", "novacore/tests"]
FULL = UT
LLM = UT + ["-p", "test_*llm*.py"]
PROMPTS = UT + ["-p", "test_[cp][ar][po]*.py"]  # test_capabilities.py, test_prompts.py
HOME_LEAK = Path.home() / ".nova-rr2-leak.txt"
TEMP_LEAK = Path(tempfile.gettempdir()) / "nova-rr2-leak.txt"


def run(cmd):
    return subprocess.run(cmd, capture_output=True, text=True, env=ENV)


def tail(r):
    lines = r.stderr.strip().splitlines()
    return lines[-3], lines[-1]


def do_break(label, name, edits, narrow, narrow_name):
    path = SRC / name
    original = path.read_bytes()
    text = original.decode("utf-8")
    for old, new in edits:
        assert text.count(old) == 1, f"{label}: anchor not found once: {old!r}"
        text = text.replace(old, new)
    path.write_bytes(text.encode("utf-8"))
    try:
        r = run(narrow)
        which = narrow_name
        if r.returncode == 0:
            r = run(FULL)
            which = narrow_name + ", then the full suite"
    finally:
        path.write_bytes(original)
        for leak in (HOME_LEAK, TEMP_LEAK):
            if leak.exists():
                leak.unlink()
    print(f"=== {label}\nfile: {path}   ran: {which}")
    for old, new in edits:
        print(f"- {old!r}\n+ {new!r}")
    for line in r.stderr.strip().splitlines():
        if line.startswith(("FAIL:", "ERROR:")):
            print("  " + line[:200])
    a, b = tail(r)
    print(f"  {a}\n  {b}\n  exit {r.returncode}: {'CAUGHT' if r.returncode else 'NOT CAUGHT'}")
    print(f"  restored: {path.read_bytes() == original}\n", flush=True)


print(f"python {sys.version.split()[0]}, os.name={os.name}\n")
r = run(FULL)
a, b = tail(r)
print(f"=== baseline, full suite\n  {a}\n  {b}\n  exit {r.returncode}\n", flush=True)

# ---------------------------------------------------------------- R10 ----
print("################ R10 breaks (narrow set: test_prompts, test_capabilities)\n")
INC = "These include camera.enable,"
B = [
    ("B3 prompt names usb2.mount", "usb2.mount"),
    ("B6 prompt names camera.enable_all", "camera.enable_all"),
    ("B7 prompt names system.reboot.force (three parts)", "system.reboot.force"),
    ("B8 prompt names x.mount (one-letter first part)", "x.mount"),
    ("B9 prompt names Camera.Record (capitals)", "Camera.Record"),
    ("B10 prompt names camera.enable-all (hyphen suffix)", "camera.enable-all"),
    ("B11 prompt names system.x (one-letter last part)", "system.x"),
    ("B12 prompt names usb-drive.mount (hyphen in first part, new)", "usb-drive.mount"),
    ("B13 prompt names camera.enable-  (trailing hyphen, new)", "camera.enable-"),
]
for label, name in B:
    do_break(label, "prompts.py", [(INC, f"These include {name}, camera.enable,")], PROMPTS, "test_prompts test_capabilities")

# ---------------------------------------------------------------- R14 ----
print("################ R14 breaks (narrow set: test_no_sockets.py)\n")
NOSOCK = UT + ["-p", "test_no_sockets.py"]
PLANT = "import socket as _s; _s.socket().close()  # planted"
S_ = [
    ("S1 socket in config.load_config", "config.py",
     '    """Load a configuration without expanding shell syntax or environment variables."""\n',
     '    """Load a configuration without expanding shell syntax or environment variables."""\n    ' + PLANT + "\n"),
    ("S2 socket in chainlog.chain_hash", "chainlog.py",
     "def chain_hash(previous: str, fields: dict) -> str:\n",
     "def chain_hash(previous: str, fields: dict) -> str:\n    " + PLANT + "\n"),
    ("S3 getaddrinfo only, in chainlog.chain_hash", "chainlog.py",
     "def chain_hash(previous: str, fields: dict) -> str:\n",
     "def chain_hash(previous: str, fields: dict) -> str:\n    import socket as _s; _s.getaddrinfo('localhost', None)  # planted\n"),
    ("S4 socket in LocalCommandBackend.complete (the real model path)", "llm.py",
     "    def complete(self, prompt: str) -> str:\n        prompt_bytes",
     "    def complete(self, prompt: str) -> str:\n        " + PLANT + "\n        prompt_bytes"),
    ("S5 socket in cli._runtime (the real session start)", "cli.py",
     "    memory = MemoryStore(config.state_dir / \"memories.jsonl\")\n",
     "    " + PLANT + "\n    memory = MemoryStore(config.state_dir / \"memories.jsonl\")\n"),
]
for label, name, old, new in S_:
    do_break(label, name, [(old, new)], NOSOCK, "test_no_sockets")

