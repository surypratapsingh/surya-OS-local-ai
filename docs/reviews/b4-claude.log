=== Appendix A: harness/gate.mjs
// claude's B4 lead-check gate over diff.json. Two rules, both written here:
//   committed: |got - want| <= 1e-10 * max(1, |want|)   (tests/differentiator.rs line 331)
//   strict:    |got - want| <= 1e-10 * |want|, and got === 0 when want === 0
//              (the rule diff.json's header states, and tests/evaluator.rs uses for B3)
// Usage: node gate.mjs <diff.json> <b4lc.wasm>
import fs from "node:fs";
const [jsonPath, wasmPath] = process.argv.slice(2);
const doc = JSON.parse(fs.readFileSync(jsonPath, "utf8"));
const { instance } = await WebAssembly.instantiate(fs.readFileSync(wasmPath), {});
const w = instance.exports;
const KINDS = ["value", "domain", "division_by_zero", "overflow", "undefined", "parse"];
const bits = (v) => { const d = new DataView(new ArrayBuffer(8)); d.setFloat64(0, v); return d.getBigUint64(0).toString(16); };
let n = 0, zero = 0, small = 0;
const fc = [], fs_ = [];
for (const c of doc.cases) {
  const text = [c.expr, c.var, ...Object.entries(c.bindings ?? {}).map(([k, v]) => `${k} ${bits(v)}`)].join("\n");
  const b = new TextEncoder().encode(text);
  const p = w.alloc(b.length);
  new Uint8Array(w.memory.buffer, p, b.length).set(b);
  const code = w.deval(p, b.length);
  const got = code === 0 ? w.value() : KINDS[code];
  const want = c.expected;
  n++;
  if (want === 0) zero++; else if (Math.abs(want) < 1) small++;
  const okC = code === 0 && Math.abs(got - want) <= 1e-10 * Math.max(1, Math.abs(want));
  const okS = code === 0 && (want === 0 ? got === 0 : Math.abs(got - want) <= 1e-10 * Math.abs(want));
  const line = `d/d${c.var} ${JSON.stringify(c.expr)} at ${JSON.stringify(c.bindings)}: got ${got}, want ${want}`;
  if (!okC) fc.push(line);
  if (!okS) fs_.push(line);
}
console.log(`cases ${n}: expected exactly 0 in ${zero}, 0 < |expected| < 1 in ${small}`);
console.log(`committed rule: ${fc.length} failures`);
for (const f of fc.slice(0, 8)) console.log("  C " + f);
console.log(`strict rule:    ${fs_.length} failures`);
for (const f of fs_.slice(0, 8)) console.log("  S " + f);

=== Appendix B: harness/src/lib.rs and harness/Cargo.toml
//! One export: differentiate and evaluate. Input "expr\nvar\nname hexbits\n...".
//! Code: 0 value (read value()), 1 domain, 2 division_by_zero, 3 overflow,
//! 4 undefined, 5 parse error.
use mathd::{differentiate, eval_at, parse, EvalError};
use std::collections::HashMap;
use std::sync::atomic::{AtomicU64, Ordering};

static VALUE: AtomicU64 = AtomicU64::new(0);

#[no_mangle]
pub extern "C" fn alloc(len: usize) -> *mut u8 {
    let mut b = Vec::<u8>::with_capacity(len);
    let p = b.as_mut_ptr();
    std::mem::forget(b);
    p
}

#[no_mangle]
pub extern "C" fn value() -> f64 {
    f64::from_bits(VALUE.load(Ordering::SeqCst))
}

/// # Safety
/// `p` points at `len` bytes from `alloc`.
#[no_mangle]
pub unsafe extern "C" fn deval(p: *const u8, len: usize) -> i32 {
    let text = std::str::from_utf8(std::slice::from_raw_parts(p, len)).unwrap();
    let mut lines = text.split('\n');
    let expr = lines.next().unwrap();
    let var = lines.next().unwrap();
    let mut env = HashMap::new();
    for line in lines {
        let (n, bits) = line.split_once(' ').unwrap();
        env.insert(n.to_string(), f64::from_bits(u64::from_str_radix(bits, 16).unwrap()));
    }
    let Ok(ast) = parse(expr) else { return 5 };
    match eval_at(&differentiate(&ast, var), &env) {
        Ok(v) => {
            VALUE.store(v.to_bits(), Ordering::SeqCst);
            0
        }
        Err(EvalError::Domain { .. }) => 1,
        Err(EvalError::DivisionByZero { .. }) => 2,
        Err(EvalError::Overflow) => 3,
        Err(EvalError::Undefined { .. }) => 4,
    }
}

[package]
name = "b4lc"
version = "0.0.0"
edition = "2021"
description = "claude's B4 lead-check gate: parse, differentiate, eval_at exported to wasm for node (scratch only)"

[lib]
crate-type = ["cdylib"]

[dependencies]
mathd = { path = "../mathd" }

=== Appendix C: harness/mag.mjs
// Count diff.json cases by |expected|, and list those with 0 < |expected| < 1e-10.
// Usage: node mag.mjs <diff.json>
import fs from "node:fs";
const doc = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
const bins = [["|want| == 0", (a) => a === 0], ["0 < |want| < 1e-10", (a) => a > 0 && a < 1e-10],
  ["1e-10 <= |want| < 1e-6", (a) => a >= 1e-10 && a < 1e-6], ["1e-6 <= |want| < 1e-3", (a) => a >= 1e-6 && a < 1e-3],
  ["1e-3 <= |want| < 1", (a) => a >= 1e-3 && a < 1], ["|want| >= 1", (a) => a >= 1]];
const nums = doc.cases.filter((c) => typeof c.expected === "number");
console.log(`header: ${JSON.stringify(Object.fromEntries(Object.entries(doc).filter(([k]) => k !== "cases")))}`);
console.log(`cases ${doc.cases.length}, numeric expected ${nums.length}, other ${doc.cases.length - nums.length}`);
for (const [name, f] of bins) console.log(`  ${name.padEnd(24)} ${nums.filter((c) => f(Math.abs(c.expected))).length}`);
console.log("cases with 0 < |want| < 1e-10 (the committed rule accepts got = 0 or got = -want for each):");
for (const c of nums.filter((c) => c.expected !== 0 && Math.abs(c.expected) < 1e-10))
  console.log(`  d/d${c.var} ${JSON.stringify(c.expr)} at ${JSON.stringify(c.bindings)} -> ${c.expected}`);

=== Appendix D: b4lc_breaks.py
"""B4 lead check: pristine gate, then breaks D1-D3 in the exponential and general power rules.

Run with cwd = <scratch>/b4lc (a byte-exact copy of HEAD's mathd/src and mathd/fixtures).
Each break edits mathd/src/differentiator.rs in the copy, rebuilds the wasm gate, runs
gate.mjs, and restores the bytes.
"""
import subprocess, sys
from pathlib import Path

SRC = Path("mathd/src/differentiator.rs")
WASM = "harness/target/wasm32-unknown-unknown/release/b4lc.wasm"
GATE = ["node", "harness/gate.mjs", "mathd/fixtures/diff.json", WASM]


def build_and_gate():
    b = subprocess.run(["cargo", "build", "--release", "--target", "wasm32-unknown-unknown", "-q"],
                       cwd="harness", capture_output=True, text=True)
    if b.returncode:
        print(b.stderr); sys.exit("build failed")
    return subprocess.run(GATE, capture_output=True, text=True).stdout


print("=== pristine\n" + build_and_gate(), flush=True)
BREAKS = [
    ("D1 exponential rule drops ln(c)", "mul(mul(term, log_c), dv)", "{ let _ = log_c; mul(term, dv) }"),
    ("D2 general power rule drops v' ln(u)", "mul(term, add(part1, part2))", "{ let _ = part1; mul(term, part2) }"),
    ("D3 general power rule drops v u'/u", "mul(term, add(part1, part2))", "{ let _ = part2; mul(term, part1) }"),
]
original = SRC.read_bytes()
for label, old, new in BREAKS:
    text = original.decode("utf-8")
    assert text.count(old) == 1, label
    SRC.write_bytes(text.replace(old, new).encode("utf-8"))
    try:
        out = build_and_gate()
    finally:
        SRC.write_bytes(original)
    print(f"=== {label}\n- {old}\n+ {new}\n{out}restored: {SRC.read_bytes() == original}\n", flush=True)
print("=== pristine again\n" + build_and_gate())

VERDICT: FAIL (L1)
