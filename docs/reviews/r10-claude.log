=== Appendix: r10_rereview.py (breaks B1-B9)
"""R10 re-review: baseline, vocabulary check, old breaks B1-B5, new breaks B6-B9.

Run with cwd = a byte-exact copy of HEAD's novacore/ and tools/.
Each break edits one source file, runs the novacore suite, restores the bytes.
"""
import os, re, subprocess, sys
from pathlib import Path

SRC = Path("novacore/src/novacore")
ENV = dict(os.environ, PYTHONPATH="novacore/src")
SUITE = [sys.executable, "-m", "unittest", "discover", "-s", "novacore/tests"]


def suite():
    return subprocess.run(SUITE, capture_output=True, text=True, env=ENV)


run = suite()
print("=== baseline (no break)")
print("  " + "\n  ".join(run.stderr.strip().splitlines()[-3:]))
print(f"  suite exit {run.returncode}\n")

# F2 asked: the current prompt still yields exactly the seven VOCABULARY names.
# The pattern is copied from test_prompts.py line 44; the expected set is typed
# here from the prompt text read by eye, not imported from the test.
sys.path.insert(0, "novacore/src")
from novacore.prompts import SYSTEM_PROMPT
found = sorted(set(re.findall(r"\b[a-z][a-z0-9_]+\.[a-z][a-z0-9_]+\b", SYSTEM_PROMPT.lower())))
by_eye = sorted({"system.status", "screen.say", "audio.speak", "camera.enable",
                 "microphone.enable", "system.reboot", "updates.apply"})
print("=== dotted names the pattern finds in SYSTEM_PROMPT")
print(f"  {found}\n  equal to the seven read by eye: {found == by_eye}\n")

BREAKS = [
    ("B1 prompt drops microphone.enable from the confirmation sentence", "prompts.py",
     "These include camera.enable,\nmicrophone.enable, system.reboot", "These include camera.enable,\nsystem.reboot"),
    ("B2 prompt network rule weakened to 'only when the owner approves'", "prompts.py",
     "Never request\ninternet access, telemetry, exports, or a network connection.",
     "Request\ninternet access only when the owner approves an export."),
    ("B3 prompt names usb2.mount (a digit in the name), absent from CATALOGUE", "prompts.py",
     "These include camera.enable,", "These include usb2.mount, camera.enable,"),
    ("B4 prompt promises a prose action with no catalogue entry ('power off')", "prompts.py",
     "An update proposal is not\nan applied update.", "You may power off the machine when asked.\nAn update proposal is not\nan applied update."),
    ("B5 _test.stub put back into the production CATALOGUE", "capabilities.py",
     '    # No test-only entries here.',
     '    "_test.stub": Capability("_test.stub", Risk.LOW, True, True, "back in the boundary"),\n    # No test-only entries here.'),
    ("B6 prompt names camera.enable_all (a real name plus a suffix)", "prompts.py",
     "These include camera.enable,", "These include camera.enable_all, camera.enable,"),
    ("B7 prompt names system.reboot.force (three segments)", "prompts.py",
     "These include camera.enable,", "These include system.reboot.force, camera.enable,"),
    ("B8 prompt names x.mount (one-letter first segment)", "prompts.py",
     "These include camera.enable,", "These include x.mount, camera.enable,"),
    ("B9 prompt names Camera.Record (capitals)", "prompts.py",
     "These include camera.enable,", "These include Camera.Record, camera.enable,"),
]
for label, name, old, new in BREAKS:
    path = SRC / name
    original = path.read_bytes()
    text = original.decode("utf-8")
    assert text.count(old) == 1, f"{label}: anchor text not found once"
    path.write_bytes(text.replace(old, new).encode("utf-8"))
    try:
        run = suite()
    finally:
        path.write_bytes(original)
    lines = run.stderr.strip().splitlines()
    print(f"=== {label}\nfile: {path}\n- {old!r}\n+ {new!r}")
    for line in lines:
        if line.startswith(("FAIL:", "ERROR:", "AssertionError")):
            print("  " + line)
    print(f"  {lines[-3]}\n  {lines[-1]}\n  suite exit {run.returncode}: {'CAUGHT' if run.returncode else 'NOT CAUGHT'}")
    print(f"  restored: {path.read_bytes() == original}\n")

