=== Appendix D: r10_f7f8.py
"""R10 second re-review: would a candidate pattern close F7 (hyphen) and F8 (one-letter last part)?

Run with cwd = repo root. Reads SYSTEM_PROMPT from the package; does not import the test.
"""
import re, sys
sys.path.insert(0, "novacore/src")
from novacore.prompts import SYSTEM_PROMPT

CURRENT = re.compile(r"\b[a-z][a-z0-9_]*(?:\.[a-z][a-z0-9_]+)+\b")
CANDIDATE = re.compile(r"\b[a-z][a-z0-9_]*(?:\.[a-z](?:[a-z0-9_-]*[a-z0-9_])?)+")

def candidate(text):
    # a name needs at least one part longer than one letter, so "e.g" and "i.e" are not names
    return {m for m in CANDIDATE.findall(text) if any(len(p) > 1 for p in m.split("."))}

def current(text):
    return set(CURRENT.findall(text))

prompt = SYSTEM_PROMPT.lower()
print("current   on prompt:", sorted(current(prompt)))
print("candidate on prompt:", sorted(candidate(prompt)))
for probe in ["e.g. this", "i.e. that", "at 9 a.m. today", "version 1.2.3", "end of sentence.",
              "system.reboot.force", "x.mount", "camera.enable-all", "system.x", "usb2.mount"]:
    print(f"{probe!r:24} current={sorted(current(probe))} candidate={sorted(candidate(probe))}")

