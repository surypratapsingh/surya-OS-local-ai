import re, sys
sys.path.insert(0, "novacore/src")
from novacore.prompts import SYSTEM_PROMPT
p = SYSTEM_PROMPT.lower()
patterns = {
    "HEAD (test_prompts.py line 44)": r"\b[a-z][a-z0-9_]+\.[a-z][a-z0-9_]+\b",
    "suggested F5": r"\b[a-z][a-z0-9_]+(?:\.[a-z][a-z0-9_]+)+\b",
    "suggested F5+F6": r"\b[a-z][a-z0-9_]*(?:\.[a-z][a-z0-9_]+)+\b",
}
for label, pat in patterns.items():
