=== Appendix A: b3_oracle_check.py
"""B3 review (claude): re-check mathd/fixtures/eval.json with a second SymPy path.

Not the generator's code. The generator's oracle is an mpmath tree walk, and its
cross-check parses the text with mpmath functions as locals. This script parses
the text with SymPy's own functions (sin, cos, tan, exp, log, sqrt, Abs), with
every literal, binding and constant given as the exact binary value of its f64
(the values mathd holds), evaluated at 50 digits.

Usage: py -3 b3_oracle_check.py <eval.json>
"""

import collections
import decimal
import json
import math
import re
import sys

import sympy as sp
from sympy.parsing.sympy_parser import parse_expr

F64_MAX = 1.7976931348623157e308
FUNCS = {"sin": sp.sin, "cos": sp.cos, "tan": sp.tan, "exp": sp.exp,
         "ln": sp.log, "sqrt": sp.sqrt, "abs": sp.Abs}
NAME = re.compile(r"[A-Za-z_]\w*")
NUMBER = re.compile(r"(?<![\w.])\d+(?:\.\d+)?(?![\w.])")


def exact(value):
    """The exact binary value of an f64, as a 50-digit SymPy Float."""
    return sp.Float(str(decimal.Decimal(float(value))), 50)


def sympy_value(text, bindings):
    names = {"pi": exact(math.pi), "e": exact(math.e), **FUNCS}
    names.update({k: exact(v) for k, v in bindings.items()})
    literal = NUMBER.sub(lambda m: "Float('%s', 50)" % decimal.Decimal(float(m.group(0))), text)
    names["Float"] = sp.Float
    return sp.N(parse_expr(literal.replace("^", "**"), local_dict=names), 50)


def unbound(text, bindings):
    return sorted({n for n in NAME.findall(text) if n not in FUNCS and n not in ("pi", "e") and n not in bindings})


def classify(value):
    if value.has(sp.zoo, sp.oo, -sp.oo, sp.nan) or value is sp.nan:
        return "non-finite (%s)" % value
    re_part, im_part = value.as_real_imag()
    if im_part != 0:
        return "non-real"
    if abs(re_part) > F64_MAX:
        return "beyond f64 max"
    return "finite real"


def main(path):
    doc = json.load(open(path, encoding="utf-8"))
    cases = doc["cases"]
    valid = [c for c in cases if "expected" in c]
    errors = [c for c in cases if "error_kind" in c]
    print("cases %d, valid %d, error %d, neither %d" % (
        len(cases), len(valid), len(errors), len(cases) - len(valid) - len(errors)))
    print("header error_kind_counts %s" % doc["error_kind_counts"])
    print("data   error_kind_counts %s" % dict(collections.Counter(c["error_kind"] for c in errors)))
    digits = collections.Counter(len(repr(float(c["expected"])).lstrip("-").split("e")[0].replace(".", "").lstrip("0")) for c in valid)
    print("significant digits stored per expected value (repr of the JSON number): max %d, histogram %s" % (
        max(digits), dict(sorted(digits.items()))))

    near = [c for c in valid if abs(c["expected"]) <= doc["zero_tolerance_absolute"]]
    print("valid cases judged by the absolute rule (|expected| <= %g): %d, of which exactly 0: %d" % (
        doc["zero_tolerance_absolute"], len(near), sum(1 for c in near if c["expected"] == 0.0)))
    for c in near:
        if c["expected"] != 0.0:
            print("   nonzero near-zero case: %r %s expected %r" % (c["expr"], c["bindings"], c["expected"]))

    worst, bad = 0.0, []
    for c in valid:
        v = sympy_value(c["expr"], c["bindings"])
        kind = classify(v)
        if kind != "finite real":
            bad.append((c, kind))
            continue
        got, want = float(sp.re(v)), c["expected"]
        if abs(want) <= 1e-10 and abs(got) <= 1e-12:
            continue
        rel = abs(got - want) / abs(want) if want else abs(got)
        worst = max(worst, rel)
        if rel > 1e-12:
            bad.append((c, "rel err %.3e (sympy %r)" % (rel, got)))
    print("valid cases re-evaluated by SymPy: %d; disagree beyond 1e-12 relative: %d; worst relative error %.3e" % (
        len(valid), len(bad), worst))
    for c, why in bad:
        print("   VALID MISMATCH %r %s expected %r: %s" % (c["expr"], c["bindings"], c["expected"], why))

    table = collections.Counter()
    listing = collections.defaultdict(list)
    for c in errors:
        names = unbound(c["expr"], c["bindings"])
        if names:
            sympy_kind = "unbound %s" % names
        else:
            try:
                sympy_kind = classify(sympy_value(c["expr"], c["bindings"]))
            except ZeroDivisionError:
                # SymPy's Float / Float(0) raises instead of returning zoo.
                sympy_kind = "ZeroDivisionError"
        short = sympy_kind.split(" (")[0].split(" [")[0]
        table[(c["error_kind"], short)] += 1
        listing[(c["error_kind"], short)].append(c["expr"] + ("  " + json.dumps(c["bindings"]) if c["bindings"] else ""))
    print("error cases: fixture kind vs what SymPy finds")
    for (kind, found), n in sorted(table.items()):
        print("   %-17s %-15s %3d" % (kind, found, n))
    for key in sorted(listing):
        if key in (("domain", "non-real"), ("undefined", "unbound"), ("overflow", "beyond f64 max")):
            continue
        print("   cases in (%s, %s): %s" % (key[0], key[1], "; ".join(listing[key])))


if __name__ == "__main__":
    main(sys.argv[1])

=== Appendix B: the wasm harness (scratch/b3/harness)

--- Cargo.toml
[package]
name = "b3harness"
version = "0.0.0"
edition = "2021"
description = "claude's B3 review harness: eval_at exported to wasm for node (scratch only, not committed)"

[lib]
crate-type = ["cdylib"]

[dependencies]
mathd = { path = "../mathd" }

--- src/lib.rs
//! One export: evaluate a case. Input: "expr\nname hexbits\n...". Output code:
//! 0 value (read it with value()), 1 domain, 2 division_by_zero, 3 overflow,
//! 4 undefined, 5 parse error. Binding values travel as f64 bit patterns.
use mathd::{eval_at, parse, EvalError};
use std::collections::HashMap;
use std::sync::atomic::{AtomicU64, Ordering};

static VALUE: AtomicU64 = AtomicU64::new(0);

#[no_mangle]
pub extern "C" fn alloc(len: usize) -> *mut u8 {
    let mut buffer = Vec::<u8>::with_capacity(len);
    let pointer = buffer.as_mut_ptr();
    std::mem::forget(buffer);
    pointer
}

#[no_mangle]
pub extern "C" fn value() -> f64 {
    f64::from_bits(VALUE.load(Ordering::SeqCst))
}

/// # Safety
/// `pointer` must point at `len` bytes written by the caller into a buffer from `alloc`.
#[no_mangle]
pub unsafe extern "C" fn eval(pointer: *const u8, len: usize) -> i32 {
    let text = std::str::from_utf8(std::slice::from_raw_parts(pointer, len)).unwrap();
    let mut lines = text.split('\n');
    let expr = lines.next().unwrap();
    let mut bindings = HashMap::new();
    for line in lines {
        let (name, bits) = line.split_once(' ').unwrap();
        bindings.insert(name.to_string(), f64::from_bits(u64::from_str_radix(bits, 16).unwrap()));
    }
    let Ok(ast) = parse(expr) else { return 5 };
    match eval_at(&ast, &bindings) {
        Ok(v) => {
            VALUE.store(v.to_bits(), Ordering::SeqCst);
            0
        }
        Err(EvalError::Domain { .. }) => 1,
        Err(EvalError::DivisionByZero { .. }) => 2,
        Err(EvalError::Overflow) => 3,
        Err(EvalError::Undefined { .. }) => 4,
    }
}

--- run.mjs
// claude's B3 review harness. The gate is written from the work order and
// tests/evaluator.rs's doc comment, with the tolerances pinned here (relative
// 1e-10; absolute 1e-10 when |expected| <= 1e-10), not read from the JSON.
// Usage: node run.mjs <eval.json> <harness.wasm>
import fs from "node:fs";
const [jsonPath, wasmPath] = process.argv.slice(2);
const doc = JSON.parse(fs.readFileSync(jsonPath, "utf8"));
const { instance } = await WebAssembly.instantiate(fs.readFileSync(wasmPath), {});
const w = instance.exports;
const KINDS = ["value", "domain", "division_by_zero", "overflow", "undefined", "parse"];
const REL = 1e-10, ZERO_ABS = 1e-10;
const bits = (v) => { const d = new DataView(new ArrayBuffer(8)); d.setFloat64(0, v); return d.getBigUint64(0).toString(16); };
let valid = 0, errors = 0;
const failures = [];
for (const c of doc.cases) {
  const text = [c.expr, ...Object.entries(c.bindings ?? {}).map(([k, v]) => `${k} ${bits(v)}`)].join("\n");
  const bytes = new TextEncoder().encode(text);
  const p = w.alloc(bytes.length);
  new Uint8Array(w.memory.buffer, p, bytes.length).set(bytes);
  const code = w.eval(p, bytes.length);
  const got = code === 0 ? w.value() : KINDS[code];
  if ("expected" in c) {
    valid++;
    const want = c.expected;
    const ok = code === 0 && (Math.abs(want) <= ZERO_ABS ? Math.abs(got) <= ZERO_ABS : Math.abs((got - want) / want) <= REL);
    if (!ok) failures.push(`VALUE ${JSON.stringify(c.expr)} ${JSON.stringify(c.bindings)}: got ${got}, want ${want}`);
  } else {
    errors++;
    if (got !== c.error_kind) failures.push(`ERROR ${JSON.stringify(c.expr)} ${JSON.stringify(c.bindings)}: got ${got}, want ${c.error_kind}`);
  }
}
console.log(`harness: ${valid} value cases, ${errors} error cases, ${failures.length} failures`);
for (const f of failures.slice(0, 5)) console.log("  " + f);
if (failures.length > 5) console.log(`  ... and ${failures.length - 5} more`);
process.exit(failures.length ? 1 : 0);

