const w = instance.exports;
const KINDS = ["Ok", "Err(domain)", "Err(division_by_zero)", "Err(overflow)", "Err(undefined)", "Err(parse)"];
const bits = (v) => { const d = new DataView(new ArrayBuffer(8)); d.setFloat64(0, v); return d.getBigUint64(0).toString(16); };
const big = "1" + "0".repeat(400);
const probes = [
  ["x", { x: NaN }], ["-x", { x: NaN }], ["x", { x: Infinity }], ["-x", { x: -Infinity }],
  ["x + 1", { x: NaN }], ["sin(x)", { x: Infinity }], ["abs(x)", { x: NaN }],
  [big + ".0", {}], ["-" + big + ".0", {}], [big, {}], [big + ".0 * 0", {}],
];
for (const [expr, b] of probes) {
  const text = [expr, ...Object.entries(b).map(([k, v]) => `${k} ${bits(v)}`)].join("\n");
  const bytes = new TextEncoder().encode(text);
  const p = w.alloc(bytes.length);
  new Uint8Array(w.memory.buffer, p, bytes.length).set(bytes);
  const code = w.eval(p, bytes.length);
  const shown = expr.length > 30 ? expr.slice(0, 12) + `...(${expr.length} chars)` : expr;
  console.log(`${shown.padEnd(28)} ${JSON.stringify(b, (k, v) => (typeof v === "number" ? String(v) : v)).padEnd(18)} -> ${KINDS[code]}${code === 0 ? " " + w.value() : ""}`);
}

