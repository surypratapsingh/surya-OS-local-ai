--- breaks.py
"""claude's B3 review breaks: one change at a time to the scratch copy of
mathd/src/evaluator.rs, rebuild the wasm harness, run the fixture gate, restore.

Run from scratchpad/b3:  py -3 breaks.py
"""

import pathlib
import subprocess

HERE = pathlib.Path(__file__).resolve().parent
SOURCE = HERE / "mathd" / "src" / "evaluator.rs"
PRISTINE = SOURCE.read_text(encoding="utf-8")

BREAKS = [
    ("Sub computes l + r", "Sub => l - r,", "Sub => l + r,"),
    ("ln computes log10", "            x.ln()\n", "            x.log10()\n"),
    ("tan computes sin", "Function::Tan => x.tan(),", "Function::Tan => x.sin(),"),
    ("sqrt domain check removed", "            if x < 0.0 {\n                return Err(EvalError::Domain { arg: x });\n            }\n            x.sqrt()",
     "            x.sqrt()"),
    ("division-by-zero check removed", "            if r == 0.0 {\n                return Err(EvalError::DivisionByZero { numerator: l });\n            }\n", ""),
    ("negative base with fractional exponent allowed", "    if base < 0.0 && expo.fract() != 0.0 {", "    if false && base < 0.0 && expo.fract() != 0.0 {"),
    ("0 ^ negative reported as Domain", "            return Err(EvalError::DivisionByZero { numerator: 1.0 });", "            return Err(EvalError::Domain { arg: 0.0 });"),
    ("constant e truncated to 2.718281828", "Const::E => std::f64::consts::E,", "Const::E => 2.718281828,"),
    ("every result below 1e-10 in magnitude flushed to 0", "fn check_finite(v: f64) -> Result<f64, EvalError> {\n",
     "fn check_finite(v: f64) -> Result<f64, EvalError> {\n    let v = if v.abs() < 1e-10 { 0.0 } else { v };\n"),
    ("tiny results returned with the wrong sign", "fn check_finite(v: f64) -> Result<f64, EvalError> {\n",
     "fn check_finite(v: f64) -> Result<f64, EvalError> {\n    let v = if v.abs() < 1e-10 { -v } else { v };\n"),
    ("final results below 1e-10 in magnitude returned with the wrong sign", "    eval_inner(expr, bindings)\n}",
     "    let v = eval_inner(expr, bindings)?;\n    Ok(if v.abs() < 1e-10 { -v } else { v })\n}"),
]


def run(command, cwd):
    done = subprocess.run(command, cwd=cwd, capture_output=True, text=True)
    return done.returncode, (done.stdout + done.stderr).strip()


try:
    for number, (name, old, new) in enumerate(BREAKS, start=1):
        assert PRISTINE.count(old) == 1, "break %d target not unique: %r" % (number, old)
        SOURCE.write_text(PRISTINE.replace(old, new), encoding="utf-8")
        code, out = run(["cargo", "build", "--target", "wasm32-unknown-unknown", "-q"], HERE / "harness")
        print("break %d: %s" % (number, name))
        if code != 0:
            print("  build failed (exit %d):\n%s" % (code, out))
            continue
        code, out = run(["node", "run.mjs", "../eval.blob.json", "target/wasm32-unknown-unknown/debug/b3harness.wasm"], HERE / "harness")
        print("\n".join("  " + line for line in out.splitlines()))
        print("  exit %d -> %s" % (code, "CAUGHT" if code != 0 else "NOT CAUGHT"))
finally:
    SOURCE.write_text(PRISTINE, encoding="utf-8")
    print("restored: %s" % (SOURCE.read_text(encoding="utf-8") == PRISTINE))

