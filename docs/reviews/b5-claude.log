=== 9. Could not do / unsure of
Could not do: run cargo test; this host cannot link it, so every number above
comes from the wasm port (port.py changes only I/O, and the baseline
reproduces the author's TP 323 and TN 2234 exactly). Not run on Linux.
Unsure of:
- V1 is shown by 8 hand-chosen probes, not by a corpus. I did not search for
  other skipped regions, for example a claim wrong only for x > 4.
- The numeric screen in section 8 uses 24 points in [-4, 4]. A Failed mutant
  equal to its original at all 24 points but not elsewhere would go to
  simplify, so it would not be missed; a mutant equivalent only on part of
  that range is called "differs", which is the right answer for the verifier.
- SymPy 1.14 Float(0.0) == 0 is False; my first oracle used == 0 and said
  "not a root" for 0.0. classify.py now uses is_zero after nsimplify. Any
  comparison against Float in the generator may have the same trap; I did not
  audit mathd/fixtures/generate.py for it.

=== Appendix A: port.py (and run.mjs)
"""Port mathd/tests/verifier.rs into a wasm cdylib, changing only I/O.
Replacements (each asserted to hit exactly once or the stated count):
  use std::fs;            -> removed
  fs::read(path)          -> fixture_read(path) (include_bytes of the same fixture)
  #[test]                 -> removed (3); run(i) export calls the three test fns
  println!/eprintln!      -> shadowed by macros that append to OUT
Usage: py -3 port.py <tests/verifier.rs> <fixture.json> <out lib.rs> [extra.rs]
"""
import sys
src, fixture, out = sys.argv[1:4]
extra = open(sys.argv[4], encoding="utf-8").read() if len(sys.argv) > 4 else ""
t = open(src, encoding="utf-8", newline="").read()
def rep(a, b, n=1):
    global t
    assert t.count(a) == n, (a, t.count(a))
    t = t.replace(a, b)
rep("use std::fs;\n", "")
rep("fs::read(path)", "fixture_read(path)")
rep("#[test]\n", "", 3)
head = r'''
use std::sync::Mutex;
static OUT: Mutex<String> = Mutex::new(String::new());
fn out(s: String) { let mut o = OUT.lock().unwrap(); o.push_str(&s); o.push('\n'); }
macro_rules! println { ($($t:tt)*) => { out(format!($($t)*)) } }
macro_rules! eprintln { ($($t:tt)*) => { out(format!($($t)*)) } }
fn fixture_read(_p: &str) -> Result<Vec<u8>, ()> { Ok(include_bytes!(r"FIXTURE").to_vec()) }
#[no_mangle] pub extern "C" fn out_ptr() -> *const u8 { OUT.lock().unwrap().as_ptr() }
#[no_mangle] pub extern "C" fn out_len() -> usize { OUT.lock().unwrap().len() }
#[no_mangle] pub extern "C" fn run(i: i32) -> i32 {
    std::panic::set_hook(Box::new(|p| out(format!("PANIC: {}", p))));
    match i {
        0 => test_verifier_accepts_all_corpus_claims(),
        1 => test_verifier_mutation_testing_rejects_mutants(),
        2 => test_verifier_unverifiable_and_counterexample_reporting(),
        _ => extra_run(i),
    }
    0
}
'''.replace("FIXTURE", fixture)
if not extra:
    head += "fn extra_run(_i: i32) {}\n"
# insert after the doc comment block (before first 'use mathd')
k = t.index("use mathd::verifier")
t = t[:k] + head + t[k:] + "\n" + extra
open(out, "w", encoding="utf-8", newline="").write(t)
print("ported", src, "->", out)

// Usage: node run.mjs <b5lc.wasm> <test index...>; prints OUT and the result of each.
import fs from "node:fs";
const [wasm, ...idx] = process.argv.slice(2);
const names = ["accepts_all_corpus_claims", "mutation_testing_rejects_mutants", "unverifiable_and_counterexample_reporting"];
let fails = 0;
for (const i of idx.map(Number)) {
  const { instance } = await WebAssembly.instantiate(fs.readFileSync(wasm), {});
  const w = instance.exports;
  let res = "ok";
  try { w.run(i); } catch (e) { res = "FAILED (" + e.message + ")"; fails++; }
  const text = new TextDecoder().decode(new Uint8Array(w.memory.buffer, w.out_ptr(), w.out_len()));
  if (text) process.stdout.write(text);
  console.log(`test ${names[i] ?? "extra " + i} ... ${res}`);
}
console.log(`result: ${idx.length - fails} passed; ${fails} failed`);
process.exit(fails ? 1 : 0);

=== Appendix B: extra.rs (mutant dump and probes)
// claude's B5 lead check: dump every mutant the committed test builds, with its verdict.
// One line per mutant: domain \t case \t kind \t original-part \t mutant \t vars \t verdict
fn vtag(v: &Verdict) -> &'static str {
    match v { Verdict::Verified { .. } => "V", Verdict::Failed { .. } => "F", Verdict::Unverifiable { .. } => "U" }
}
fn extra_run(i: i32) {
    if i == 4 { return probes(); }
    let root = read_verifier_fixtures();
    let cases = root.get("cases").and_then(|v| v.as_arr()).unwrap();
    let s = |c: &Json, k: &str| c.get(k).and_then(|v| v.as_str()).unwrap().to_string();
    for (ci, case) in cases.iter().enumerate() {
        match s(case, "kind").as_str() {
            "integral" => {
                let f = parse(&s(case, "integrand")).unwrap();
                let a = parse(&s(case, "claimed_antiderivative")).unwrap();
                let var = s(case, "var");
                for (m, k) in generate_expression_mutations(&a) {
                    let v = verify_integral(&f, &m, &var);
                    println!("integral\t{}\t{:?}\t{}\t{}\t{}\t{}\t{}", ci, k, mathd::print(&f), mathd::print(&a), mathd::print(&m), var, vtag(&v));
                }
            }
            "identity" => {
                let l = parse(&s(case, "lhs")).unwrap();
                let r = parse(&s(case, "rhs")).unwrap();
                let vars: Vec<String> = case.get("vars").and_then(|v| v.as_arr()).unwrap().iter().map(|v| v.as_str().unwrap().to_string()).collect();
                let vr: Vec<&str> = vars.iter().map(|x| x.as_str()).collect();
                for (m, k) in generate_expression_mutations(&r) {
                    let v = verify_identity(&l, &m, &vr);
                    println!("identity\t{}\t{:?}\t{}\t{}\t{}\t{}\t{}", ci, k, mathd::print(&l), mathd::print(&r), mathd::print(&m), vars.join(","), vtag(&v));
                }
            }
            "factorisation" => {
                let o = parse(&s(case, "original")).unwrap();
                let fs: Vec<Ast> = case.get("claimed_factors").and_then(|v| v.as_arr()).unwrap().iter().map(|f| parse(f.as_str().unwrap()).unwrap()).collect();
                let show = |v: &[Ast]| v.iter().map(|x| format!("({})", mathd::print(x))).collect::<Vec<_>>().join("*");
                if fs.len() > 1 {
                    let mut b = fs.clone(); b.pop();
                    let v = verify_factorisation(&o, &b);
                    println!("factorisation\t{}\tDropFactor\t{}\t{}\t{}\t-\t{}", ci, mathd::print(&o), show(&fs), show(&b), vtag(&v));
                }
                for (i, f) in fs.iter().enumerate() {
                    let all = generate_expression_mutations(f);
                    let n = all.len();
                    for (j, (mf, k)) in all.into_iter().enumerate() {
                        let mut b = fs.clone(); b[i] = mf;
                        let v = verify_factorisation(&o, &b);
                        let used = if j < 2 { "used" } else { "unused" };
                        println!("factorisation\t{}\t{:?}/{}of{}/{}\t{}\t{}\t{}\t-\t{}", ci, k, j, n, used, mathd::print(&o), show(&fs), show(&b), vtag(&v));
                    }
                }
            }
            "equation" => {
                let l = parse(&s(case, "lhs")).unwrap();
                let r = parse(&s(case, "rhs")).unwrap();
                let var = s(case, "var");
                let roots: Vec<f64> = case.get("claimed_roots").and_then(|v| v.as_arr()).unwrap().iter().map(|r| r.as_f64().unwrap()).collect();
                let eq = Equation::new(l.clone(), r.clone());
                for i in 0..roots.len() {
                    for d in [1.0f64, -1.0] {
                        let mut b = roots.clone(); b[i] += d;
                        let v = verify_equation_solution(&eq, &b, &var);
                        println!("equation\t{}\tMutateRoot{:+}\t{} = {}\t{:?}\t{:?}\t{}\t{}", ci, d, mathd::print(&l), mathd::print(&r), roots, b, var, vtag(&v));
                    }
                }
            }
            _ => {}
        }
    }
}

// claude's B5 probes: claims that are false for x < 0 only. Each line: claim, verdict, evidence.
fn probes() {
    let id = |l: &str, r: &str, v: &[&str]| {
        let verdict = verify_identity(&parse(l).unwrap(), &parse(r).unwrap(), v);
        println!("identity      {:<22} == {:<26} vars {:?}: {:?}", l, r, v, verdict);
    };
    let int = |f: &str, a: &str| {
        let verdict = verify_integral(&parse(f).unwrap(), &parse(a).unwrap(), "x");
        println!("integral      d/dx[{}] == {}: {:?}", a, f, verdict);
    };
    let fac = |o: &str, fs: &[&str]| {
        let v: Vec<Ast> = fs.iter().map(|f| parse(f).unwrap()).collect();
        let verdict = verify_factorisation(&parse(o).unwrap(), &v);
        println!("factorisation {} == {:?}: {:?}", o, fs, verdict);
    };
    id("x", "abs(x)", &["x"]);
    id("x", "sqrt(x ^ 2)", &["x"]);
    id("x ^ 3", "abs(x) ^ 3", &["x"]);
    id("sin(x)", "sin(abs(x))", &["x"]);
    id("x * y", "abs(x) * abs(y)", &["x", "y"]);
    int("abs(x)", "x ^ 2 / 2");
    int("x", "x * abs(x) / 2");
    fac("x ^ 3 - x", &["abs(x)", "x - 1", "x + 1"]);
    // control: a claim false for some positive x must fail
    id("x", "x + 0.001", &["x"]);
}

=== Appendix C: breaks.py
"""claude's B5 lead check: plant faults in the scratch copy of mathd/src/verifier.rs,
rebuild the wasm port of tests/verifier.rs, run its three tests, restore the bytes.
Usage: py -3 breaks.py   (run from the b5 scratch directory)
"""
import subprocess, sys
SRC = "mathd/src/verifier.rs"
WASM = "harness/target/wasm32-unknown-unknown/release/b5lc.wasm"
LOOP_FAIL = """                if diff > VERIFIER_TOLERANCE * scale {
                    return Verdict::Failed {
                        counterexample: pt,
                        expected: e,
                        got: g,
                    };
                }
"""
BREAKS = [
    ("K1 tolerance 1e-9 widened to 1e-3",
     "pub const VERIFIER_TOLERANCE: f64 = 1e-9;", "pub const VERIFIER_TOLERANCE: f64 = 1e-3;"),
    ("K2 Verified after 1 agreeing point (MIN 8 -> 1, TARGET 16 -> 1)",
     "pub const MIN_TEST_POINTS: usize = 8;\n", "pub const MIN_TEST_POINTS: usize = 1;\n"),
    ("K3 mismatching points skipped, not Failed (Verified when 8 points agree)",
     LOOP_FAIL, "                if diff > VERIFIER_TOLERANCE * scale {\n                    continue;\n                }\n"),
    ("K4 equation: only the first claimed root is checked",
     "    for &root in claimed_roots {\n", "    for &root in claimed_roots.iter().take(1) {\n"),
    ("K5 tolerance scale floor 1 raised to 1e6 in verify_equivalence loop",
     "                let scale = e.abs().max(1.0);\n                let rel_err", "                let scale = e.abs().max(1e6);\n                let rel_err"),
]
orig = open(SRC, "rb").read()
def run(label):
    b = subprocess.run(["cargo", "build", "--release", "--target", "wasm32-unknown-unknown"],
                       cwd="harness", capture_output=True, text=True)
    if b.returncode:
        print("  BUILD FAILED:", b.stderr[-400:]); return
    r = subprocess.run(["node", "run.mjs", WASM, "0", "1", "2"], capture_output=True, text=True)
    for line in r.stdout.splitlines():
        if line.startswith(("test ", "result", "PANIC", "  True", "  False")):
            print("  " + line[:200])
    print(f"  exit {r.returncode}: {'CAUGHT' if r.returncode else 'NOT CAUGHT'}")
# K2 needs TARGET too
for name, old, new in BREAKS:
    t = orig.decode("utf-8")
    n = t.count(old)
    print(f"=== {name}")
    if n != 1:
        print(f"  pattern found {n} times; skipped"); continue
    t = t.replace(old, new)
    if name.startswith("K2"):
        t = t.replace("pub const TARGET_SAMPLE_POINTS: usize = 16;", "pub const TARGET_SAMPLE_POINTS: usize = 1;")
    open(SRC, "wb").write(t.encode("utf-8"))
    try:
        run(name)
    finally:
        open(SRC, "wb").write(orig)
        print("  restored:", open(SRC, "rb").read() == orig)
print("=== baseline after restore")
run("baseline")

=== Appendix D: classify.py and classify_f.py
"""Independent oracle (SymPy) for every mutant the committed test excuses or skips.
Reads dump.tsv from extra_run. For integral 'V' rows: is d/dvar(mutant) - integrand == 0?
For identity 'V'/'U' rows: is lhs - mutant == 0? For equation 'V' rows: are the claimed
roots a correct solution set (every root a root, and every real root claimed)?
Usage: py -3 classify.py dump.tsv [verdicts, default VU; VUF checks Failed rows too]
"""
import sys
import sympy as sp
from sympy.parsing.sympy_parser import parse_expr, standard_transformations, convert_xor
T = standard_transformations + (convert_xor,)
NS = {"e": sp.E, "pi": sp.pi, "ln": sp.log, "abs": sp.Abs, "sqrt": sp.sqrt}
def P(s):
    return parse_expr(s, local_dict=dict(NS), transformations=T)
def zero(expr, syms):
    # SymPy 1.13+: Float(0.0) == 0 is False, so test with is_zero, after nsimplify.
    d = sp.simplify(sp.nsimplify(expr))
    return d.is_zero is True
MODE = sys.argv[2] if len(sys.argv) > 2 else "VU"
rows = [l.rstrip("\n").split("\t") for l in open(sys.argv[1], encoding="utf-8") if "\t" in l]
tally = {}
for r in rows:
    dom, ci, kind = r[0], r[1], r[2]
    v = r[-1]
    if dom == "integral" and v in MODE:
        f, a, m, var = r[3], r[4], r[5], r[6]
        x = sp.Symbol(var)
        ok = zero(sp.diff(P(m), x) - P(f), [x])
        tag = f"integral {v} {'equivalent' if ok else 'NOT-equivalent'}"
        print(tag, f"case {ci} {kind}: d/d{var}[{m}] vs {f}")
    elif dom == "identity" and v in MODE:
        l, rhs, m = r[3], r[4], r[5]
        ok = zero(P(l) - P(m), None)
        tag = f"identity {v} {'equivalent' if ok else 'NOT-equivalent'}"
        print(tag, f"case {ci} {kind}: {l} vs {m}")
    elif dom == "equation" and v in MODE:
        eqs, roots, bad, var = r[3], eval(r[4]), eval(r[5]), r[6]
        lhs, rhs = eqs.split(" = ")
        x = sp.Symbol(var)
        real = set(sp.solveset(P(lhs) - P(rhs), x, domain=sp.S.Reals))
        each_root = all(sp.simplify((P(lhs) - P(rhs)).subs(x, sp.nsimplify(b))).is_zero is True for b in bad)
        complete = {sp.nsimplify(b) for b in bad} == real
        tag = f"equation {v} each-claimed-is-root={each_root} set-complete={complete}"
        print(tag, f"case {ci} {kind}: {eqs} real roots {sorted(real)} claimed {bad}")
    else:
        continue
    tally[tag] = tally.get(tag, 0) + 1
print("--- tally")
for k, n in sorted(tally.items()):
    print(f"{n:5} {k}")

"""Independent check of the Failed mutants: is any of them actually equivalent
(a false Failed)? SymPy evaluates lhs - mutant (identity) or d/dx mutant - integrand
(integral) at 24 points in [-4, 4] with 30-digit precision. A row whose difference is
below 1e-20 at every point where both sides are real is then checked with simplify.
Equation rows: a Failed list must contain a non-root (exact SymPy substitution).
Usage: py -3 -u classify_f.py dump.tsv
"""
import sys, random
import sympy as sp
from classify import P
random.seed(1017)
PTS = [sp.Rational(random.randint(-4000, 4000), 1000) for _ in range(24)]
def near_zero_everywhere(expr, syms):
    hit = 0
    for i, p in enumerate(PTS):
        sub = {s: PTS[(i + k * 7) % len(PTS)] for k, s in enumerate(syms)}
        try:
            v = sp.N(expr.subs(sub), 30)
        except Exception:
            continue
        if not v.is_real:
            continue
        if abs(v) > 1e-20:
            return False
        hit += 1
    return hit > 0
tally = {}
for line in open(sys.argv[1], encoding="utf-8"):
    r = line.rstrip("\n").split("\t")
    if len(r) < 5 or r[-1] != "F":
        continue
    dom, ci, kind = r[0], r[1], r[2]
    if dom == "integral":
        x = sp.Symbol(r[6]); d = sp.diff(P(r[5]), x) - P(r[3]); syms = sorted(d.free_symbols, key=str)
    elif dom == "identity":
        d = P(r[3]) - P(r[5]); syms = sorted(d.free_symbols, key=str)
    elif dom == "factorisation":
        d = P(r[3]) - P(r[5]); syms = sorted(d.free_symbols, key=str)
    elif dom == "equation":
        lhs, rhs = r[3].split(" = "); x = sp.Symbol(r[6]); bad = eval(r[5])
        f = P(lhs) - P(rhs)
        if f.free_symbols - {x}:
            tag = "equation F has parameters, skipped"
        else:
            nonroot = any(sp.simplify(f.subs(x, sp.nsimplify(b))).is_zero is not True for b in bad)
            tag = f"equation F contains-a-non-root={nonroot}"
        tally[tag] = tally.get(tag, 0) + 1
        if "False" in tag: print(tag, ci, kind, r[3], bad)
        continue
    else:
        continue
    if not syms:
        z = sp.N(d, 30); suspect = z.is_real and abs(z) < 1e-20
    else:
        suspect = near_zero_everywhere(d, syms)
    if suspect:
        eq = sp.simplify(sp.nsimplify(d)).is_zero is True
        tag = f"{dom} F suspect, simplify-equivalent={eq}"
        print(tag, ci, kind, r[3], "|", r[5])
    else:
        tag = f"{dom} F differs at a sampled point"
    tally[tag] = tally.get(tag, 0) + 1
print("--- tally")
for k, n in sorted(tally.items()):
    print(f"{n:5} {k}")

