## 3. The plant script
import sys
from pathlib import Path
PLANTS = {
  "P1-pdf-parentheses-unescaped": ("novacore/src/novacore/documents.py",
     '.replace(b"(", b"\\\\(").replace(b")", b"\\\\)")', ''),
  "P2-overwrite-allowed": ("novacore/src/novacore/documents.py",
     "os.O_CREAT | os.O_EXCL | os.O_WRONLY", "os.O_CREAT | os.O_TRUNC | os.O_WRONLY"),
  "P3-spotify-words-not-encoded": ("novacore/src/novacore/desktop.py",
     '"spotify:search:" + quote(query, safe="")', '"spotify:search:" + query'),
  "P4-any-file-type-plays": ("novacore/src/novacore/desktop.py",
     'matches = [m for m in self._search(query)[0] if Path(m[0]).suffix.casefold() in AUDIO_SUFFIXES]',
     'matches = list(self._search(query)[0])'),
  "P5-raw-title-as-file-name": ("novacore/src/novacore/documents.py",
     '    name = " ".join(_UNSAFE.sub(" ", title).split())[:60].strip()', '    name = title.strip()'),
  "P6-docx-text-not-escaped": ("novacore/src/novacore/documents.py",
     '<w:t xml:space="preserve">{escape(text)}</w:t>', '<w:t xml:space="preserve">{text}</w:t>'),
}
name = sys.argv[1]; path, old, new = PLANTS[name]
t = Path(path).read_text(encoding="utf-8")
assert t.count(old) == 1, f"{name}: anchor found {t.count(old)} times"
Path(path).write_text(t.replace(old, new), encoding="utf-8"); print(path)
