## 7. score.py
"""N4c scoring, run once after training: test3 in full (the gate), test3 without the
lines that occur verbatim in train/dev, and the spent sets (seen data, context only)."""
import json, re, sys
sys.path.insert(0, "novacore/src")
from novacore import intent
norm = lambda t: " ".join(re.findall(r"[a-z0-9]+", t.lower()))
model = intent.Model("intent/model/nova-intent.bin")
seen = {norm(l.split("\t")[1]) for f in ("intent/data/train.tsv", "intent/data/dev.tsv") for l in open(f, encoding="utf-8")}
load = lambda path: [json.loads(l) for l in open(path, encoding="utf-8") if l.strip()]
def show(name, rows, apps):
    r = intent.evaluate(model, rows, apps)
    failures = r.pop("failures")
    print(f"== {name}: " + json.dumps(r))
    for kind, text, got in failures:
        print(f"   {kind}: {text!r} -> {json.dumps(got)}")
apps = json.load(open("intent/data/test2-config.json"))["apps"]
test3 = load("intent/data/test3.jsonl")
show("test3, all 152 lines (THE GATE)", test3, apps)
unseen = [r for r in test3 if norm(r["text"]) not in seen]
show(f"test3 without the {len(test3) - len(unseen)} lines that occur verbatim in train/dev", unseen, apps)
show("test2.jsonl (SEEN DATA since N4c, context only, not a test)", load("intent/data/test2.jsonl"), apps)
show("test.jsonl (SEEN DATA since N4b, context only, not a test)", load("intent/data/test.jsonl"),
     json.load(open("intent/data/test-config.json"))["apps"])
