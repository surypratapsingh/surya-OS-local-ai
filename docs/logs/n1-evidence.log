#!/usr/bin/env bash
# A real interactive NovaCore session with the N1 router, for docs/logs/n1-evidence.log.
# Chat runner: novacore/tests/fake_runner.py. Router runner:
# novacore/tests/STUB_router_runner.py (scripted, NOT a model).
set -u
repo=/home/user/surya-OS-local-ai
work=$(mktemp -d)
mkdir -p "$work/docs/physics" "$work/docs/school"
echo x > "$work/docs/physics/notes chapter3.pdf"
echo x > "$work/docs/physics/notes chapter4.pdf"
echo x > "$work/docs/school/timetable.pdf"
echo x > "$work/docs/school/install.sh"
cat > "$work/config.toml" <<TOML
[model]
command = ["$(command -v python3)", "$repo/novacore/tests/fake_runner.py"]
timeout_seconds = 10
max_output_chars = 1000
use_stdin = true

[router]
command = ["$(command -v python3)", "$repo/novacore/tests/STUB_router_runner.py", "{schema_file}"]
timeout_seconds = 10
max_output_chars = 2000
use_stdin = true

[desktop]
confirm_all_actions = false
folders = ["$work/docs"]

[desktop.apps]
probe = ["$(command -v python3)", "-c", "open('$work/probe-started', 'w').write('ran')"]

[conversation]
history_turns = 2
memory_results = 2

[storage]
state_dir = "state"
TOML
echo "\$ cat config.toml"; sed "s#$work#WORK#g" "$work/config.toml"
echo
echo "\$ printf '...' | python3 -m novacore --config config.toml"
printf '%s\n' "/capabilities" "what time is it" "find notes" "find chapter3" "find install" "remember buy milk on friday" "no" "remember buy milk on friday" "yes" "/mem milk" "start probe" "start calc" "hello" "/quit" \
  | (cd "$repo" && LANG=C.UTF-8 PYTHONPATH=novacore/src python3 -m novacore --config "$work/config.toml" 2>&1) | sed "s#$work#WORK#g"
echo "exit status: ${PIPESTATUS[1]}"
sleep 1
echo; echo "\$ ls WORK  (probe-started exists if apps.open really started the program)"; ls "$work"
echo; echo "\$ cat WORK/state/events.jsonl   (the audit log; one CAPABILITY_RUN per action that ran)"
sed "s#$work#WORK#g" "$work/state/events.jsonl"
echo; echo "\$ python3 -m json.tool WORK/state/router/schema.json | head -40   (what a grammar-capable runner is given)"
python3 -m json.tool "$work/state/router/schema.json" | head -40
echo "\$ stat -c '%a %n' on the schema file and its folder"; stat -c '%a %n' "$work/state/router/schema.json" "$work/state/router" | sed "s#$work#WORK#g"
rm -rf "$work"
