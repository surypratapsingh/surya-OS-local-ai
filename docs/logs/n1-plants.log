---- plants.sh
#!/usr/bin/env bash
# Run each N1 planted break against the full novacore suite, then revert it.
cd /home/user/surya-OS-local-ai || exit 1
export LANG=C.UTF-8 PYTHONPATH=novacore/src
PLANT=/tmp/claude-0/-home-user-surya-OS-local-ai/a2d9d327-0aab-56b9-8f14-a234bbf8ed79/scratchpad/n1/plant.py
echo "# N1 planted breaks - $(date -u '+%Y-%m-%d %H:%M:%S UTC') - HEAD $(git rev-parse --short HEAD)"
echo "\$ git status --short   (before)"; git status --short; echo "(clean if nothing above)"
for p in P1-router-sees-memory P2-parser-accepts-extra-key P3-path-check-removed P4-assistant-confirms-by-itself P5-broker-confirmation-check-removed P6-broker-acts-before-verifying-outbox P7-any-file-type-opens; do
  echo; echo "================ $p"
  file=$(python3 "$PLANT" "$p") || exit 1
  echo "\$ git diff -- $file"; git diff -- "$file"
  echo "\$ python3 -m unittest discover -s novacore/tests -p 'test_*.py'   (summary: failing tests, then the last 3 lines)"
  out=$(timeout 900 python3 -m unittest discover -s novacore/tests -p 'test_*.py' 2>&1); rc=$?
  printf '%s\n' "$out" | grep -E '^(FAIL|ERROR):' | sort | uniq
  printf '%s\n' "$out" | grep -E '^AssertionError' | head -4 | cut -c1-220
  printf '%s\n' "$out" | tail -3
  echo "suite exit status: $rc  -> $([ $rc -ne 0 ] && echo CAUGHT || echo 'NOT CAUGHT')"
  git checkout -- "$file"
  echo "\$ git checkout -- $file && git status --short"; git status --short; echo "(clean if nothing above)"
done
echo; echo "================ unplanted re-run"
timeout 900 python3 -m unittest discover -s novacore/tests -p 'test_*.py' 2>&1 | tail -3
---- plant.py
"""Apply one planted break: replace OLD with NEW exactly once in FILE."""
import sys
from pathlib import Path

PLANTS = {
    "P1-router-sees-memory": (
        "novacore/src/novacore/assistant.py",
        "        route = self.router.route(text)\n",
        "        route = self.router.route(text + ' ' + ' '.join(m.text for m in self.companion.memory.search(text, 3)))\n",
    ),
    "P2-parser-accepts-extra-key": (
        "novacore/src/novacore/router.py",
        '    if set(value) != {"route", "capability", "args"}:\n',
        '    if not {"route", "capability", "args"} <= set(value):\n',
    ),
    "P3-path-check-removed": (
        "novacore/src/novacore/desktop.py",
        "                if os.path.commonpath([real, root]) == root:\n",
        "                if True:\n",
    ),
    "P4-assistant-confirms-by-itself": (
        "novacore/src/novacore/assistant.py",
        "        if capability.requires_confirmation or self.confirm_all_actions:\n",
        "        if False:\n",
    ),
    "P5-broker-confirmation-check-removed": (
        "novacore/src/novacore/capabilities.py",
        "        if capability.requires_confirmation and not owner_confirmed:\n",
        "        if False:\n",
    ),
    "P6-broker-acts-before-verifying-outbox": (
        "novacore/src/novacore/capabilities.py",
        "        sequence, previous_chain_hash = self.verify()\n        try:\n            result = self.executor.run(name, dict(arguments))\n",
        "        try:\n            result = self.executor.run(name, dict(arguments))\n        finally:\n            sequence, previous_chain_hash = self.verify()\n        try:\n            pass\n",
    ),
    "P7-any-file-type-opens": (
        "novacore/src/novacore/desktop.py",
        "        openable = [item for item in matches if Path(item[0]).suffix.casefold() in OPENABLE_SUFFIXES]\n",
        "        openable = list(matches)\n",
    ),
}

name = sys.argv[1]
path, old, new = PLANTS[name]
if name == "P4-assistant-confirms-by-itself":
    # P4 also makes the direct call claim the owner's confirmation.
    extra_old = "        return format_result(self.broker.request(route.capability, dict(route.args)))\n"
    extra_new = "        return format_result(self.broker.request(route.capability, dict(route.args), owner_confirmed=True))\n"
else:
    extra_old = extra_new = None
text = Path(path).read_text(encoding="utf-8")
assert text.count(old) == 1, f"{name}: anchor not found exactly once"
text = text.replace(old, new)
if extra_old:
    assert text.count(extra_old) == 1
    text = text.replace(extra_old, extra_new)
Path(path).write_text(text, encoding="utf-8")
print(path)
