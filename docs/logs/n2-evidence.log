## 3. The plant script
import sys
from pathlib import Path
PLANTS = {
  "V1-no-wake-word-needed": ("novacore/src/novacore/voice.py",
     "            if not self.waiting():\n                return None  # not addressed to NOVA: dropped, never stored\n", ""),
  "V2-every-line-is-an-answer": ("novacore/src/novacore/voice.py",
     "            if not self.waiting():\n", "            if False:\n"),
  "V3-speaker-failure-crashes": ("novacore/src/novacore/voice.py",
     "        except (OSError, subprocess.TimeoutExpired) as error:\n            self._speaker_broken = True",
     "        except ZeroDivisionError as error:\n            self._speaker_broken = True"),
  "V5-wake-word-by-characters": ("novacore/src/novacore/voice.py",
     "        if [w for w, _, _ in spoken[:len(wake_tokens)]] == wake_tokens:",
     "        if line.lower().startswith(wake.lower()) or any(w.startswith(wake_tokens[0]) for w, _, _ in spoken[:1]):"),
}
name = sys.argv[1]; path, old, new = PLANTS[name]
t = Path(path).read_text(encoding="utf-8")
assert t.count(old) == 1, f"{name}: anchor found {t.count(old)} times"
Path(path).write_text(t.replace(old, new), encoding="utf-8"); print(path)
