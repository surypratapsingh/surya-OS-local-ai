## 7. score.py
"""N4b scoring, run once after training: test2 in full (the gate), test2 without
the lines that occur verbatim in train/dev, and the N4 set (seen data, context only)."""
import json, re, sys
sys.path.insert(0, "novacore/src")
from novacore import intent
norm = lambda t: " ".join(re.findall(r"[a-z0-9]+", t.lower()))
model = intent.Model("intent/model/nova-intent.bin")
seen = {norm(l.split("\t")[1]) for f in ("intent/data/train.tsv", "intent/data/dev.tsv") for l in open(f, encoding="utf-8")}
def load(path):
    return [json.loads(l) for l in open(path, encoding="utf-8") if l.strip()]
def show(name, rows, apps):
    r = intent.evaluate(model, rows, apps)
    failures = r.pop("failures")
    print(f"== {name}: " + json.dumps(r))
    for kind, text, got in failures:
        print(f"   {kind}: {text!r} -> {json.dumps(got)}")
apps2 = json.load(open("intent/data/test2-config.json"))["apps"]
test2 = load("intent/data/test2.jsonl")
show("test2, all 219 lines (THE GATE)", test2, apps2)
unseen = [r for r in test2 if norm(r["text"]) not in seen]
show(f"test2 without the {len(test2) - len(unseen)} lines that occur verbatim in train/dev", unseen, apps2)
show("test.jsonl (N4 set; SEEN DATA since N4b, context only, not a test)", load("intent/data/test.jsonl"),
     json.load(open("intent/data/test-config.json"))["apps"])
