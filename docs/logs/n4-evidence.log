## 11. The scripts behind sections 3 and 9
---- diag (section 3): a test file with this body, run with cargo test --release --test zz_diag_tmp -- --nocapture
#    (same model, input and targets as intent/tests/gradcheck.rs; prints analytic vs single-step vs Richardson for 4 parameters)
---- session.sh (section 9)
#!/usr/bin/env bash
# A real NovaCore session whose router is NOVA's own trained model (N4).
# Chat runner: novacore/tests/fake_runner.py (a stand-in for a chat model).
# Router: novacore/src/novacore/intent.py with intent/model/nova-intent.bin.
set -u
repo=/home/user/surya-OS-local-ai
work=$(mktemp -d)
mkdir -p "$work/docs/physics" "$work/docs/school"
echo x > "$work/docs/physics/notes chapter3.pdf"
echo x > "$work/docs/physics/notes chapter4.pdf"
echo x > "$work/docs/school/timetable.pdf"
py=$(command -v python3)
cat > "$work/config.toml" <<TOML
[model]
command = ["$py", "$repo/novacore/tests/fake_runner.py"]
timeout_seconds = 10
max_output_chars = 1000
use_stdin = true

[router]
command = ["$py", "-I", "$repo/novacore/src/novacore/intent.py", "--model", "$repo/intent/model/nova-intent.bin", "{schema_file}"]
use_stdin = true
timeout_seconds = 30
max_output_chars = 2000

[desktop]
confirm_all_actions = false
folders = ["$work/docs"]

[desktop.apps]
spotify = ["$py", "-c", "open('$work/spotify-started', 'w').write('ran')"]

[conversation]
history_turns = 2
memory_results = 2

[storage]
state_dir = "state"
TOML
echo "\$ cat config.toml"; sed "s#$work#WORK#g" "$work/config.toml"
echo
echo "\$ printf '...' | python3 -m novacore --config config.toml"
printf '%s\n' "what time is it" "find my physics notes" "open spotify" "remember that my exam is on Monday" "yes" \
  "what is the volume of a sphere" "remind me in 10 minutes to stretch" "turn the volume up" "open photoshop" "/quit" \
  | (cd "$repo" && LANG=C.UTF-8 PYTHONPATH=novacore/src python3 -m novacore --config "$work/config.toml" 2>&1) | sed "s#$work#WORK#g"
echo "exit status: ${PIPESTATUS[1]}"
sleep 1
echo; echo "\$ ls WORK  (spotify-started exists if apps.open really started the configured program)"; ls "$work"
echo; echo "\$ python3 -c '...'   (the audit log, one line per action that ran: capability, applied, result)"
python3 -c "
import json, sys
for line in open(sys.argv[1], encoding='utf-8'):
    e = json.loads(line); print(e['sequence'], e['capability']['name'], 'applied' if e['applied'] else 'NOT applied', '|', e['result'])
" "$work/state/events.jsonl"
rm -rf "$work"
