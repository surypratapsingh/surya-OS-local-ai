"""Apply one N4 planted break: replace OLD with NEW exactly once in FILE."""
import sys
from pathlib import Path

PLANTS = {
    "P1-attention-backward-sign": (
        "intent/src/model.rs",
        "let ds = row[s] * (dp[s] - mean) * scale;",
        "let ds = row[s] * (mean - dp[s]) * scale;",
    ),
    "P2-layernorm-backward-drops-a-term": (
        "intent/src/model.rs",
        "dx[k] += rstd[r] * (dxhat[j] - mean_dxhat - xhat[k] * mean_dxhat_xhat);",
        "dx[k] += rstd[r] * (dxhat[j] - mean_dxhat);",
    ),
    "P3-fnv-prime": (
        "intent/src/features.rs",
        "hash = hash.wrapping_mul(0x0100_0193);",
        "hash = hash.wrapping_mul(0x0100_0197);",
    ),
    "P4-python-attention-unscaled": (
        "novacore/src/novacore/intent.py",
        "            weights = _softmax([sum(map(mul, q[i], k[s])) * scale for s in range(t)])",
        "            weights = _softmax([sum(map(mul, q[i], k[s])) for s in range(t)])",
    ),
    "P5-runtime-ignores-the-offer": (
        "novacore/src/novacore/intent.py",
        "    if capability not in offer.capabilities:\n        return chat\n",
        "",
    ),
    "P6-unknown-app-falls-back-to-the-first": (
        "novacore/src/novacore/intent.py",
        "    return hits[0] if len(hits) == 1 else None",
        "    return hits[0] if len(hits) == 1 else (offered[0] if offered else None)",
    ),
    "P7-hours-read-as-minutes": (
        "novacore/src/novacore/intent.py",
        "        minutes = number * 60",
        "        minutes = number",
    ),
    "P8-runner-fails-open": (
        "novacore/src/novacore/intent.py",
        '        print(f"novacore.intent: {type(error).__name__}: {error}", file=sys.stderr)\n        return json.dumps({"route": "chat"})',
        '        print(f"novacore.intent: {type(error).__name__}: {error}", file=sys.stderr)\n        return json.dumps({"route": "action", "capability": "time.now", "args": {}})',
    ),
}

name = sys.argv[1]
path, old, new = PLANTS[name]
text = Path(path).read_text(encoding="utf-8")
assert text.count(old) == 1, f"{name}: anchor not found exactly once in {path}"
Path(path).write_text(text.replace(old, new), encoding="utf-8")
print(path)
