---- plants.sh
#!/usr/bin/env bash
# N4 planted breaks: each one against the suite that should catch it, then reverted.
cd /home/user/surya-OS-local-ai || exit 1
export LANG=C.UTF-8 PYTHONPATH=novacore/src
S=/tmp/claude-0/-home-user-surya-OS-local-ai/a2d9d327-0aab-56b9-8f14-a234bbf8ed79/scratchpad/n4
echo "# N4 planted breaks - $(date -u '+%Y-%m-%d %H:%M:%S UTC') - HEAD $(git rev-parse --short HEAD)"
echo "\$ git status --short   (before)"; git status --short; echo "(clean if nothing above)"
# The gate test (test_intent.GateTests) fails before any plant: that is the
# N4 finding. Python plants are judged against every other class in test_intent.py.
PY_CLASSES="test_intent.TokenAndFeatureTests test_intent.DecodingTests test_intent.ModelFileTests test_intent.AgreesWithTheRustTrainerTests test_intent.OfferTests test_intent.RouterRunnerTests"
echo; echo "================ baselines (unplanted)"
echo "\$ cargo test --release --manifest-path intent/Cargo.toml   (summary)"
timeout 900 cargo test --release --manifest-path intent/Cargo.toml 2>&1 | grep -E "^test result"
echo "\$ (cd novacore/tests && python3 -m unittest $PY_CLASSES)   (last 3 lines)"
(cd novacore/tests && PYTHONPATH=../src timeout 900 python3 -m unittest $PY_CLASSES 2>&1 | tail -3)
for p in P1-attention-backward-sign P2-layernorm-backward-drops-a-term P3-fnv-prime P4-python-attention-unscaled P5-runtime-ignores-the-offer P6-unknown-app-falls-back-to-the-first P7-hours-read-as-minutes P8-runner-fails-open; do
  echo; echo "================ $p"
  file=$(python3 "$S/plant.py" "$p") || exit 1
  echo "\$ git diff -- $file"; git diff -- "$file" | grep -E '^[-+][^-+]'
  case "$file" in
    intent/*) cmd="cargo test --release --manifest-path intent/Cargo.toml"; out=$(timeout 900 $cmd 2>&1); rc=$?
              echo "\$ $cmd   (summary)"
              printf '%s\n' "$out" | grep -E "^test .*FAILED|panicked at|^(parameter|assertion)|test result: FAILED|left:|right:" | head -8 | cut -c1-220 ;;
    *)        cmd="python3 -m unittest $PY_CLASSES"; out=$(cd novacore/tests && PYTHONPATH=../src timeout 900 $cmd 2>&1); rc=$?
              echo "\$ $cmd   (summary)"
              printf '%s\n' "$out" | grep -E "^(FAIL|ERROR):|^AssertionError" | sort | uniq | head -8 | cut -c1-220
              printf '%s\n' "$out" | tail -3 ;;
  esac
  echo "exit status: $rc  -> $([ $rc -ne 0 ] && echo CAUGHT || echo 'NOT CAUGHT')"
  git checkout -- "$file"
  echo "\$ git checkout -- $file && git status --short"; git status --short; echo "(clean if nothing above)"
done
