## 8. What each model answers on the lesson words. TRAINING-SET RECALL: the retrained model saw these lines 20 times.
## This shows the pipeline works. It does not show the model reads new wording better; that needs the owner's real commands.
$ cat /tmp/claude-0/-home-user-surya-OS-local-ai/a2d9d327-0aab-56b9-8f14-a234bbf8ed79/scratchpad/n4d/compare.py
"""N4d trial: what the shipped v3 model and a model retrained with the example
lessons answer on the lesson words themselves. TRAINING-SET RECALL: these lines
were in the second model's training data (20 copies each), so this shows the
pipeline works, not that the model reads new wording better.

    PYTHONPATH=novacore/src python3 compare.py V3_MODEL RETRAINED_MODEL LESSONS_JSONL
"""

import json
import sys
from pathlib import Path

from novacore import intent
from novacore.teaching import TeachingStore

offer = intent.Offer(intent.ALL_CAPABILITIES, ("diary",))
models = {"v3": intent.Model(Path(sys.argv[1])), "retrained": intent.Model(Path(sys.argv[2]))}
lessons = TeachingStore(Path(sys.argv[3])).all()
right = dict.fromkeys(models, 0)
for lesson in lessons:
    if lesson.verdict == "chat":
        wanted = {"route": "chat"}
    else:
        wanted = {"route": "action", "capability": lesson.capability, "args": lesson.arguments}
    print(f"{lesson.text!r}: lesson {json.dumps(wanted, sort_keys=True)}")
    for label, model in models.items():
